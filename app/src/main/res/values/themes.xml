<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EightyIn8" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Launch/splash theme (core-splashscreen). Swaps to Theme.EightyIn8 once loaded. -->
    <style name="Theme.EightyIn8.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.EightyIn8</item>
    </style>
</resources>
